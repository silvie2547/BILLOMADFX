APP_NAME="BILLOMADFX API"
ENVIRONMENT=development
# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace-with-a-random-secret-before-deployment
# Local default uses SQLite. For PostgreSQL use postgresql+psycopg://user:password@localhost:5432/billomadfx
DATABASE_URL=sqlite:///./data/billomadfx.db
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
